# openplate-sync configuration.
#
# Copy to `.env` and edit. Everything marked REQUIRED must be set or the
# service refuses to start — deliberately. A sync service that boots with a
# weak secret and starts taking accounts is a much worse outcome than one that
# will not boot.
#
# The parser lives in `src/config.ts`; keep the two in step.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Postgres connection string.
DATABASE_URL=postgres://openplate:openplate@localhost:5432/openplate_sync

# Root secret, at least 32 characters. Generate one and never rotate it
# casually:
#
#   openssl rand -hex 32
#
# Two domain-separated subkeys are derived from it (`src/lib/server-secrets.ts`):
# the pepper mixed into every stored auth verifier, and the key behind the
# deterministic dummy KDF descriptors served for unknown emails.
#
# CHANGING IT INVALIDATES EVERY EXISTING LOGIN. Every account would have to go
# through a passphrase reset. Treat it like a database password, and back it up
# with the database — a restored database with a lost secret is a database
# nobody can log into.
SERVER_SECRET=

# Where your openplate client is served. Verification and reset emails link
# here (this service has no UI of its own).
CLIENT_BASE_URL=https://openplate.example.com

# ── Optional ────────────────────────────────────────────────────────────────

PORT=3000
LOG_LEVEL=info

# Set to `false` to close registration on a personal or family instance. The
# service keeps working for existing accounts.
SIGNUPS_OPEN=true

# Require a confirmed email address before the first login. Off by default: a
# family instance with the console mail transport works fine without it, and
# turning it on before mail is configured locks everyone out.
REQUIRE_EMAIL_VERIFICATION=false

# Number of reverse proxies in front of this service (`1` behind a single
# nginx/Traefik), or `true`/`false`.
#
# GET THIS RIGHT. Left at `false` behind a proxy, `req.ip` is the proxy's
# address and the per-IP throttle becomes ONE global bucket that a single
# attacker can lock for every user. Set to `true` with no proxy in front and
# anyone can spoof `X-Forwarded-For` to escape the throttle entirely.
TRUST_PROXY=false

# Enable only if your Postgres requires TLS.
DATABASE_SSL=false

# ── Admin API (optional, off by default) ────────────────────────────────────
# Enables `/v1/admin` and the `pnpm sync-api` CLI over it: account metadata,
# aggregate storage counts, and account erasure (the DSAR mechanism).
#
# LEAVE IT UNSET UNLESS YOU WANT THE FEATURE. Unset, the whole `/v1/admin`
# tree answers the same 404 any unknown path does — an instance without this
# variable is indistinguishable from one built before the feature existed.
# That is deliberate: a 401 would advertise that a credential exists here and
# is merely locked.
#
# Generate it, do not choose it: `openssl rand -hex 32`. Minimum 24
# characters. It can list every account and delete any of them; it can never
# read a blob, a verifier or a KDF descriptor — see
# docs/adr/0001-an-admin-api-for-a-zero-knowledge-service.md.
ADMIN_TOKEN=

# ── Diary sharing (optional, off by default) ────────────────────────────────
# Enables the clinician-sharing endpoint family: a patient wraps their data
# key to a clinician's PUBLIC key, and the clinician reads the patient's blob
# through a share row. The server's position does not change — it holds one
# more blob it has no key for, and it never stores, generates or endorses a
# share public key.
#
# LEAVE IT UNSET UNLESS YOU WANT THE FEATURE. Unset, both `/v1/sync/shares`
# and `/v1/sync/shared` answer the same 404 any unknown path does, to
# everybody, with or without a valid token — same bargain ADMIN_TOKEN makes,
# and for the same reason.
#
# Accepts true/false or 1/0. See
# docs/adr/0002-sharing-a-diary-without-giving-the-server-a-key.md, including
# what revocation can and cannot do: it controls the future, and it cannot
# repossess what a clinician already downloaded.
SYNC_SHARING=false

# ── Mail ────────────────────────────────────────────────────────────────────
#
# Transports are selected by precedence: pigeon (both variables set) → SMTP
# (SMTP_HOST set) → console. With none of them set, verification and reset
# links are printed to the service log — a fully supported way to run a
# personal instance.

EMAIL_FROM=openplate <noreply@example.com>

# SMTP (the usual self-host choice).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Pigeon HTTP transport (used by the hosted instance). This is a hand-written
# HTTP client, not an SDK — this repo has no private-registry dependencies and
# will not gain any.
PIGEON_API_KEY=
PIGEON_BASE_URL=

# ── Docker Compose only ─────────────────────────────────────────────────────
# Read by `docker/compose.yml` to provision the bundled Postgres.

POSTGRES_USER=openplate
POSTGRES_PASSWORD=openplate
POSTGRES_DB=openplate_sync
SYNC_PORT=3000

# ── Tests only ──────────────────────────────────────────────────────────────
# The integration suite targets the shared local Postgres, never the
# `docker/compose.yml` database above. Contributors without one can start
# `docker/compose.dev.yml`, which serves exactly the default URL below.
# Override if yours lives elsewhere.

# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/openplate_sync_test

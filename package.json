{
  "name": "openplate-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone account + E2EE blob-sync service for openplate \u2014 Bitwarden-model accounts over CAS blob push/pull and wrapped-DEK key records, on a versioned wire protocol (see PROTOCOL.md). Stores opaque ciphertext only; it cannot decrypt what it holds.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --import tsx --watch src/main.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "test:integration": "node --import tsx --test --test-concurrency=1 'tests/integration/**/*.test.ts'",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "format:check": "prettier --check \"**/*.{ts,md,json}\"",
    "drizzle:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "drizzle:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "drizzle:push": "tsx node_modules/drizzle-kit/bin.cjs push",
    "drizzle:studio": "tsx node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.30.6",
    "esbuild": "^0.24.2",
    "oxlint": "1.78.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
